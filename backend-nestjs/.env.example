# Backend Environment Configuration
# Copy this file to .env and fill in the values

# Server Configuration
PORT=3001
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/DSS2
# For MongoDB Atlas, use:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/DSS2?retryWrites=true&w=majority

# ML API
ML_API_URL=http://localhost:5000
ML_API_TIMEOUT=30000  # milliseconds

# JWT (if applicable)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRATION=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug
# Options: error, warn, debug, verbose

# Application
APP_NAME=DSS-Antigravity
APP_VERSION=1.0.0

# Feature Flags
ENABLE_PREDICTION_HISTORY=true
ENABLE_WHAT_IF=true
ENABLE_EXPLAINABILITY=true
